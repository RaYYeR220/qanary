{
  "name": "@qanary/sdk",
  "version": "0.1.0",
  "description": "Post-quantum signers, key store and ERC-7913 verifier client for Qanary smart accounts on Arbitrum",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1145.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@scure/bip39": "^2.4.0"
  },
  "peerDependencies": {
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "viem": "^2.57.2",
    "vitest": "^5.0.3"
  }
}
